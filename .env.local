# ─────────────────────────────────────────────────────────────────────────
#  Copy this file to  .env.local  and fill in real values.
#  .env.local is git-ignored and must NEVER be committed or shared.
# ─────────────────────────────────────────────────────────────────────────

# Gmail inbox that receives the DealerCenter MFA codes (do-not-reply@dealercenter.net).
# Use a Gmail APP PASSWORD (Google Account > Security > App passwords), NOT your login password.
GMAIL_ADDRESS=catalogue@spyne.ai
GMAIL_APP_PASSWORD=123@catalogue

# ── DealerCenter accounts ────────────────────────────────────────────────
# DC_ACCOUNT_n_NAME must EXACTLY match the top-level folder name in your data
# folder (case/spacing are matched loosely, e.g. "Capitol of Smithfield").
#
# DC_ACCOUNT_n_ROOFTOP is optional. Set it when several account folders share
# ONE DealerCenter login and are reached by switching dealership in-app instead
# of logging out and back in (this is the Capitol group below). Use the name
# as it appears in the "Switch Dealership" list in DealerCenter.

DC_ACCOUNT_1_NAME=International Auto
DC_ACCOUNT_1_USER=Godblessu
DC_ACCOUNT_1_PASS=IAuto@1223455

DC_ACCOUNT_2_NAME=Mega Motors
DC_ACCOUNT_2_USER=Mega123
DC_ACCOUNT_2_PASS=Karmendra@12345

# Capitol group: one login (AvinashJha), three rooftops switched in-app.
DC_ACCOUNT_3_NAME=Capitol
DC_ACCOUNT_3_USER=AvinashJha
DC_ACCOUNT_3_PASS=Team@1234567
DC_ACCOUNT_3_ROOFTOP=Capitol Auto

DC_ACCOUNT_4_NAME=Capitol of Smithfield
DC_ACCOUNT_4_USER=AvinashJha
DC_ACCOUNT_4_PASS=Team@1234567
DC_ACCOUNT_4_ROOFTOP=Capitol Auto of Smithfield

DC_ACCOUNT_5_NAME=Capitol Auto of Zebulon
DC_ACCOUNT_5_USER=AvinashJha
DC_ACCOUNT_5_PASS=Team@1234567
DC_ACCOUNT_5_ROOFTOP=Capitol Auto of Zebulon
