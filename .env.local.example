# ─────────────────────────────────────────────────────────────────────────
#  Copy this file to  .env.local  and fill in real values.
#  .env.local is git-ignored and must NEVER be committed or shared.
# ─────────────────────────────────────────────────────────────────────────

# Gmail inbox that receives the DealerCenter MFA codes (do-not-reply@dealercenter.net).
# Use a Gmail APP PASSWORD (Google Account > Security > App passwords), NOT your login password.
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── DealerCenter accounts ────────────────────────────────────────────────
# DC_ACCOUNT_n_NAME must EXACTLY match the top-level folder name in your data
# folder (case/spacing are matched loosely, e.g. "Capitol of Smithfield").

DC_ACCOUNT_1_NAME=International Auto
DC_ACCOUNT_1_USER=Godblessu
DC_ACCOUNT_1_PASS=IAuto@1223455

DC_ACCOUNT_2_NAME=Mega Motors
DC_ACCOUNT_2_USER=Mega123
DC_ACCOUNT_2_PASS=Karmendra@12345

